{
  "name": "ai-for-kids",
  "version": "1.0.0",
  "private": true,
  "description": "AI for Kids \u2014 a playful, safe platform where children aged 6-16 learn AI, coding, and creativity.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && npm run check:units",
    "typecheck": "tsc --noEmit",
    "build:assets": "node scripts/build-assets.mjs",
    "check:images": "node scripts/check-image-props.mjs --self-test && node scripts/check-image-props.mjs",
    "check:safety": "node scripts/check-safety.mjs",
    "check:output": "node scripts/check-output-safety.mjs",
    "check:challenges": "node scripts/check-challenges.mjs",
    "check:curriculum": "node scripts/check-curriculum.mjs",
    "check:reveal": "node scripts/check-reveal.mjs",
    "check:bundle": "node scripts/check-bundle.mjs --self-test && node scripts/check-bundle.mjs",
    "check:api": "node scripts/check-tutor-api.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:live": "node scripts/check-live-ai.mjs",
    "check:units": "npm run check:images && npm run check:safety && npm run check:output && npm run check:challenges && npm run check:curriculum && npm run check:reveal && npm run check:video",
    "check": "npm run typecheck && npm run lint && npm run check:pages && npm run check:api && npm run check:bundle",
    "build:video": "node scripts/build-video.mjs",
    "check:video": "node scripts/check-video-wiring.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.3.0",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
