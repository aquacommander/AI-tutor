# Anthropic API key — powers the Sparky AI Tutor and Creative Studio (Milestone 2).
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Daily ceiling on AI spend, in USD. Defaults to 5 if unset.
# A brake, not a guarantee — it is per-instance and resets on deploy. Set a real
# hard limit on the key itself in the Anthropic console.
AI_DAILY_USD_CAP=5

# Public site URL, used for canonical + Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Commerce (optional) ----------------------------------------------------
# Where a buy button goes. Without these the pricing page says the shop is not
# open rather than showing a button that does nothing.
# NEXT_PUBLIC_CHECKOUT_BUNDLE=https://buy.stripe.com/...
# NEXT_PUBLIC_CHECKOUT_AI_DETECTIVE_ACADEMY=https://buy.stripe.com/...
# NEXT_PUBLIC_ENQUIRY_EMAIL=hello@example.com

# Override the flat $25 per course if pricing is revisited.
# NEXT_PUBLIC_PRICE_AI_DETECTIVE_ACADEMY=25

# ---- Contact and social (optional) ------------------------------------------
# The footer renders only what is set, so an account that does not exist yet is
# simply absent rather than a broken link.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# NEXT_PUBLIC_INSTAGRAM=https://instagram.com/...
# NEXT_PUBLIC_YOUTUBE=https://youtube.com/@...
# NEXT_PUBLIC_FACEBOOK=https://facebook.com/...
# NEXT_PUBLIC_TIKTOK=https://tiktok.com/@...
