# Anthropic API key — powers the Sparky AI Tutor and Creative Studio (Milestone 2).
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Daily ceiling on AI spend, in USD. Defaults to 5 if unset.
# A brake, not a guarantee — it is per-instance and resets on deploy. Set a real
# hard limit on the key itself in the Anthropic console.
AI_DAILY_USD_CAP=5

# Public site URL, used for canonical + Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
